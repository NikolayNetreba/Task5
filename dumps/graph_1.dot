digraph g{ 
rankdir=LR; 
node [shape=Mrecord; style=filled;];
node0 [label = "{<prev> prev = 1 | { index = 0 | info = 0 } | <next> next = 1}"; fillcolor="#757373"; fontcolor="black"; color="black"; penwidth=1.0];
node1 [label = "{<prev> prev = 0 | { index = 1 | info = 10 } | <next> next = 0}"; fillcolor="#87CEEB"; fontcolor="black"; color="black"; penwidth=1.0];
node2 [label = "{<prev> prev = -1 | { index = 2 | info = -1 } | <next> next = 3}"; fillcolor="#FFF3B0"; fontcolor="black"; color="black"; penwidth=1.0];
node3 [label = "{<prev> prev = -1 | { index = 3 | info = -1 } | <next> next = 4}"; fillcolor="#E9ECEF"; fontcolor="black"; color="black"; penwidth=1.0];
node4 [label = "{<prev> prev = -1 | { index = 4 | info = -1 } | <next> next = 5}"; fillcolor="#E9ECEF"; fontcolor="black"; color="black"; penwidth=1.0];
node5 [label = "{<prev> prev = -1 | { index = 5 | info = -1 } | <next> next = 6}"; fillcolor="#E9ECEF"; fontcolor="black"; color="black"; penwidth=1.0];
node6 [label = "{<prev> prev = -1 | { index = 6 | info = -1 } | <next> next = 0}"; fillcolor="#E9ECEF"; fontcolor="black"; color="black"; penwidth=1.0];
node0 -> node1 [style=invis, weight=100];
node1 -> node2 [style=invis, weight=100];
node2 -> node3 [style=invis, weight=100];
node3 -> node4 [style=invis, weight=100];
node4 -> node5 [style=invis, weight=100];
node5 -> node6 [style=invis, weight=100];
node0:next -> node1:prev [color="#10b542", dir="both", penwidth=2.0, constraint=false];
node1:next -> node0:prev [color="#10b542", dir="both", penwidth=2.0, constraint=false];
HEAD [shape=box, style="filled, rounded", fillcolor="#87CEEB", label="HEAD"];
TAIL [shape=box, style="filled, rounded", fillcolor="#F4C2C2", label="TAIL"];
FREE [shape=box, style="filled, rounded", fillcolor="#FFF3B0", label="FREE"];
HEAD -> node1 [color=black];
TAIL -> node1 [color=black];
FREE -> node2 [color=black];
}
